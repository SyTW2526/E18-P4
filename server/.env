## Copy this file to `server/.env` and update values before starting the server
# Example: point the server to your new Mongo VM in oVirt.
# Replace <VM_IP> and <PASSWORD> with your VM IP and root password
# Use the following format for a direct Mongo connection string:
# ATLAS_URI=mongodb://root:<PASSWORD>@<VM_IP>:27017/meanStackExample?authSource=admin
# Or, if using MongoDB Atlas, use the connection string provided by Atlas:
# ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/meanStackExample?retryWrites=true&w=majority

